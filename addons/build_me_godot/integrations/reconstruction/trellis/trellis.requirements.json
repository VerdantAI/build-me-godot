{
  "schema_version": 1,
  "provider_id": "trellis",
  "adapter_version": 1,
  "status": "experimental_user_managed_command",
  "code_repository": "microsoft/TRELLIS",
  "code_license": "MIT",
  "model_repository": "microsoft/TRELLIS-image-large",
  "weight_license": "MIT",
  "commercial_use": true,
  "input_contract": "single_image",
  "joint_multiview_conditioning": false,
  "hardware": {
    "os": "Linux",
    "gpu": "NVIDIA CUDA",
    "minimum_vram_gb": 16
  },
  "build_me_godot_command_contract": {
    "version_probe": "--version",
    "arguments": ["--input", "<image>", "--output", "<mesh.glb>", "--metadata-output", "<metadata.json>"],
    "automatic_downloads_allowed": false
  },
  "required_local_configuration": [
    "BUILD_ME_GODOT_TRELLIS_ROOT or TRELLIS_ROOT",
    "BUILD_ME_GODOT_TRELLIS_MODEL_PATH",
    "BUILD_ME_GODOT_TRELLIS_PYTHON optional"
  ],
  "output_formats": ["glb", "json"],
  "report": "metadata.json"
}
